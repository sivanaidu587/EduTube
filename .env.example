# Auth Configuration Example
# Copy to .env and customize

# Generate hash: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('yourpassword'))"
AUTH_SECRET_KEY=your-super-secret-key-here-use-generated-one
DEMO_EMAIL=demo@example.com
DEMO_PASS_HASH=$2b$12$examplehashhere
DEMO_PHONE=+1-234-567-8900

# Other project env vars go here
OPENAI_API_KEY=sk-...

